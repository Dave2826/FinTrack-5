# Plantilla del entorno de pruebas aislado (Actividad 3).
# Uso:  cp .env.test.example .env.test  y sustituye los marcadores.
# .env.test esta excluido de Git (.gitignore) y de la imagen (.dockerignore).
# Esta plantilla NO contiene credenciales reales.

# --- PostgreSQL (base de pruebas fintrack5_test) ---
# Los scripts de setup/limpieza exigen DB_NAME=fintrack5_test y
# DB_HOST=postgres (dentro de la red de Docker); se niegan a correr
# contra la base de desarrollo.
POSTGRES_DB=fintrack5_test
POSTGRES_USER=fintrack5_test_user
POSTGRES_PASSWORD=CAMBIAR-PASSWORD-FICTICIA-DE-PRUEBAS

# --- JWT (solo entorno de pruebas, Actividad 6) ---
# El secreto se lee exclusivamente de JWT_SECRET; el algoritmo (HS256)
# y la vigencia (30 minutos) son fijos en security/jwt.py.
JWT_SECRET=CAMBIAR-SECRETO-FICTICIO-DE-PRUEBAS

# --- pgadmin (perfil "herramientas"; opcional) ---
PGADMIN_EMAIL=pruebas-ficticias@example.invalid
PGADMIN_PASSWORD=CAMBIAR-PASSWORD-FICTICIA-DE-PRUEBAS

# --- Interpolacion del compose.yaml base ---
# compose.test.yaml resetea los puertos (!reset []), pero Compose
# puede advertir si estas variables no estan definidas al parsear
# el archivo base. Valores ficticios, sin efecto en el entorno de pruebas.
APP_PORT=8002
POSTGRES_PORT=5434
PGADMIN_PORT=5052
