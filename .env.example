# Plantilla del entorno de desarrollo (Actividad 5).
# Uso:  cp .env.example .env  y sustituye los marcadores CAMBIAR-*.
# .env esta excluido de Git (.gitignore) y de la imagen (.dockerignore).
# Esta plantilla NO contiene credenciales reales; todos los valores
# son ficticios y solo sirven de referencia para configurar el entorno.

# --- Aplicacion y puertos (interpolacion de compose.yaml) ---
APP_PORT=8002
POSTGRES_PORT=5434
PGADMIN_PORT=5052

# --- PostgreSQL (base de desarrollo actividad5) ---
# DB_* es la configuracion que leen la aplicacion (database/connection.py)
# y Alembic (alembic/env.py) dentro del contenedor; DB_HOST es el nombre
# del servicio en la red de Docker, no localhost.
POSTGRES_DB=actividad5
POSTGRES_USER=actividad5_user
POSTGRES_PASSWORD=CAMBIAR-PASSWORD-FICTICIA
DB_NAME=actividad5
DB_USER=actividad5_user
DB_PASSWORD=CAMBIAR-PASSWORD-FICTICIA
DB_HOST=postgres
DB_PORT=5432

# --- pgAdmin (perfil "herramientas"; opcional) ---
PGADMIN_EMAIL=admin@example.invalid
PGADMIN_PASSWORD=CAMBIAR-PASSWORD-FICTICIA

# --- JWT (autenticacion) ---
JWT_SECRET_KEY=CAMBIAR-SECRETO-FICTICIO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
